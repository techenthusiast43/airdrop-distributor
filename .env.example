# Reown (WalletConnect) Project ID from https://cloud.reown.com
VITE_REOWN_PROJECT_ID=your_reown_project_id

# Deployed AirdropDistributor contract address on BotChain Mainnet (Chain ID 677)
# Automatically populated by `npm run deploy`
VITE_DISTRIBUTOR_CONTRACT_ADDRESS=

# Deployer Private Key (without 0x prefix or with 0x)
PRIVATE_KEY=your_private_key_here
